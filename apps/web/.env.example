# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API). Use a new v3 project — do not reuse the v2 Clerk database.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# After pull, apply supabase/migrations/004_lock_profile_privileges.sql on the live project.

# Local only — unlock the worksheet without a platform purchase (ignored in production)
# DEV_UNLOCK_PLATFORM=true

# Clinic dashboard list price is public. Set false to hide it again.
# NEXT_PUBLIC_CLINIC_TIER_PUBLIC=false

# Stripe (use a restricted key in production: rk_live_...)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 14-day checklist campaign (see docs/14days.md)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@claimsaverplus.com
LEAD_IP_SALT=

# Admin console (see docs/admin.md). Seed only; never self-promote in the UI.
OWNER_SEED_EMAIL=support@claimsaverplus.com
ADMIN_MFA_PHONE=+17864173869
# Optional Twilio. Without it, the code still texts via carrier email + OWNER inbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRON_SECRET=
# Counsel must confirm. Used by /api/cron/retention.
RETENTION_YEARS=7
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
# Optional override. Default is the public ClaimSaver+ clinic demo schedule.
NEXT_PUBLIC_CLINIC_DEMO_BOOKING_URL=https://calendar.app.google/obrSBdpVtAjhj4rG9

# Optional: DocuSign remote notarization
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Expo (apps/mobile) — same API as the web app
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
