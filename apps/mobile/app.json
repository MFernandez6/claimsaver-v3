{
  "expo": {
    "name": "ClaimSaver+",
    "slug": "claimsaver-plus",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "claimsaver",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.claimsaverplus.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of accident scenes, vehicle damage, and documents for your PIP file.",
        "NSPhotoLibraryUsageDescription": "Attach existing photos and documents to your claim workspace.",
        "NSMicrophoneUsageDescription": "Optional if you later use video for notarization."
      }
    },
    "android": {
      "package": "com.claimsaverplus.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-512.png",
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker"
    ]
  }
}
