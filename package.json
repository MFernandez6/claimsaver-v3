{
  "name": "claimsaver-plus",
  "private": true,
  "version": "3.0.0",
  "description": "ClaimSaver+ — Florida PIP guided claim platform (web + mobile)",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @claimsaver/web",
    "dev:web": "npm run dev -w @claimsaver/web",
    "dev:mobile": "npm run start -w @claimsaver/mobile",
    "build": "npm run build -w @claimsaver/web",
    "lint": "npm run lint -w @claimsaver/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "auth-emails:write": "node supabase/templates/write-html.mjs",
    "auth-emails:push": "node supabase/templates/push.mjs",
    "social:founder-promo": "node scripts/generate-founder-ig-promo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/supabase-js": "2.50.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
